# Copy this file to a new file named .env and fill in your own values.
# The .env file is private and is NOT pushed to GitHub.

DJANGO_SECRET_KEY=change-me-to-any-long-random-text
DEBUG=True

# False = use the simple SQLite file (easy for Member 2 and Member 3 while building)
# True  = use PostgreSQL (Member 1 and the final demo)
USE_POSTGRES=False
DB_NAME=verilabel
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Memurai (Redis for Windows) address used by Celery
REDIS_URL=redis://localhost:6379/0

# True = use the sample files in mocks/ instead of the real AI step
USE_MOCK_VISION=True
# True = run background tasks inside Django (no Memurai needed).
# False = use Memurai and a Celery worker.
CELERY_EAGER=True